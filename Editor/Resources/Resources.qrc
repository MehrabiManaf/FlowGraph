<RCC>
    <qresource prefix="/Icons">
        <file alias="continue.svg">Icons/continue.svg</file>
        <file alias="interrupt.svg">Icons/interrupt.svg</file>
        <file alias="stop.svg">Icons/stop.svg</file>
        <file alias="add.svg">Icons/add.svg</file>
        <file alias="new.svg">Icons/new.svg</file>
        <file alias="open.svg">Icons/open.svg</file>
        <file alias="save.svg">Icons/save.svg</file>
        <file alias="configure.svg">Icons/configure.svg</file>
        <file alias="save-as.svg">Icons/save-as.svg</file>
        <file alias="exit.svg">Icons/exit.svg</file>
        <file alias="undo.svg">Icons/undo.svg</file>
        <file alias="redo.svg">Icons/redo.svg</file>
        <file alias="cut.svg">Icons/cut.svg</file>
        <file alias="copy.svg">Icons/copy.svg</file>
        <file alias="paste.svg">Icons/paste.svg</file>
        <file alias="duplicate.svg">Icons/duplicate.svg</file>
        <file alias="delete.svg">Icons/delete.svg</file>
        <file alias="select-all.svg">Icons/select-all.svg</file>
        <file alias="comment.svg">Icons/comment.svg</file>
        <file alias="clear.svg">Icons/clear.svg</file>
        <file alias="step-into.svg">Icons/step-into.svg</file>
        <file alias="step-out.svg">Icons/step-out.svg</file>
        <file alias="step-over.svg">Icons/step-over.svg</file>
        <file alias="attach.svg">Icons/attach.svg</file>
        <file alias="detach.svg">Icons/detach.svg</file>
    </qresource>
</RCC>
