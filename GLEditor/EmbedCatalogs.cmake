# Writes OUTPUT, a C++ source with the catalogs of translations in it (Source/Language.cpp reads them): CATALOGS is kind=path
# items separated by |, the kind "editor" (GLEditor/Translations/<code>.json, the texts of the editor and of GLWidgets) or "nodes"
# (Core/Translations/<code>.json, the texts of the built-in nodes), or "icon" (an SVG file: Source/Icons.cpp). Each file goes in as raw string literals of a few
# thousand bytes (a compiler takes no longer literal), joined when it is read.
#   cmake -DOUTPUT=<file.cpp> "-DCATALOGS=editor=a.json|nodes=b.json" -P EmbedCatalogs.cmake
set(chunk 4000)
set(code "// Generated by GLEditor/EmbedCatalogs.cmake from the catalogs of translations: not to be edited.\n")
string(APPEND code "#include \"Language.hpp\"\n\nnamespace fged::gl {\n\nnamespace {\n\n")
set(entries "")
set(index 0)
string(REPLACE "|" ";" CATALOGS "${CATALOGS}")
foreach(item IN LISTS CATALOGS)
    string(REPLACE "=" ";" parts "${item}")
    list(GET parts 0 kind)
    list(GET parts 1 path)
    get_filename_component(language "${path}" NAME_WE)
    file(READ "${path}" content)
    string(FIND "${content}" ")fgjson\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${path} has the raw string's delimiter in it")
    endif()
    string(LENGTH "${content}" length)
    string(APPEND code "const char* const catalog${index}[] = {\n")
    set(at 0)
    while(at LESS length)
        # cut at the end of a line: a cut inside a character of several bytes (Persian, Chinese) would leave a literal that
        # is not text, which the compiler changes
        string(SUBSTRING "${content}" ${at} ${chunk} piece)
        math(EXPR rest "${length} - ${at}")
        if(rest GREATER chunk)
            string(FIND "${piece}" "\n" newline REVERSE)
            if(newline GREATER 0)
                math(EXPR keep "${newline} + 1")
                string(SUBSTRING "${piece}" 0 ${keep} piece)
            endif()
        endif()
        string(LENGTH "${piece}" taken)
        string(APPEND code "    R\"fgjson(${piece})fgjson\",\n")
        math(EXPR at "${at} + ${taken}")
    endwhile()
    string(APPEND code "    nullptr};\n\n")
    string(APPEND entries "        {\"${kind}\", \"${language}\", catalog${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND code "} // namespace\n\nconst std::vector<EmbeddedCatalog>& embeddedCatalogs() {\n")
string(APPEND code "    static const std::vector<EmbeddedCatalog> all{\n${entries}    };\n    return all;\n}\n\n} // namespace fged::gl\n")
# written only when it changed: what includes it is not built again for nothing
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" before)
    if(before STREQUAL code)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${code}")
